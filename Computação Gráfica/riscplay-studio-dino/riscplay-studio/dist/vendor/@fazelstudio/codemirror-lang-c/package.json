{
  "name": "@fazelstudio/codemirror-lang-c",
  "version": "0.1.0",
  "description": "C language support for the CodeMirror code editor",
  "license": "MIT",
  "author": "Zulfazli (Fazelllyyy)",
  "homepage": "https://github.com/fazel-studio/codemirror-lang-c#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/fazel-studio/codemirror-lang-c.git"
  },
  "bugs": {
    "url": "https://github.com/fazel-studio/codemirror-lang-c/issues"
  },
  "keywords": [
    "codemirror",
    "codemirror6",
    "editor",
    "c",
    "lezer",
    "language",
    "syntax-highlighting"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "npm run build:grammar && rollup -c && node -e \"const fs=require('fs');['parser.js','parser.terms.js','highlight.js','tokens.js'].forEach(f=>{try{fs.copyFileSync('src/'+f,'dist/'+f)}catch(e){}});\"",
    "build:grammar": "lezer-generator src/c.grammar -o src/parser.js",
    "watch": "rollup -c -w",
    "test": "mocha test/test-c.js"
  },
  "peerDependencies": {
    "@codemirror/language": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@lezer/common": "^1.2.0",
    "@lezer/highlight": "^1.2.0",
    "@lezer/lr": "^1.4.0"
  },
  "peerDependenciesMeta": {
    "@codemirror/state": { "optional": true },
    "@codemirror/view": { "optional": true }
  },
  "devDependencies": {
    "@lezer/generator": "^1.7.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-typescript": "^11.0.0",
    "mocha": "^10.0.0",
    "rollup": "^4.0.0",
    "tslib": "^2.6.0",
    "typescript": "^5.4.0"
  }
}
